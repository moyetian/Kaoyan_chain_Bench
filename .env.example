# KaoyanBench 环境变量示例（.env.example）
# ---------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env
#   # 编辑 .env（.env 已被 .gitignore 忽略，不会入库）
#   set -a; source .env; set +a     # 导出到当前 shell
#
# ★ 本项目**零第三方依赖**，以下变量**全部可选**：
#   - 只跑离线 smoke / validate：**一个都不需要设置**。
#   - 需要真实语义评测（Semantic Grader）时才设置 GRADER_* 相关变量。
#
# ★ 变量名均已在代码/配置中核实存在（见 docs/06-部署指南.md 的核实说明）。
# ★ 任何 API key 都**绝不**写入仓库；.env / *.env 已被 .gitignore 忽略。
# ---------------------------------------------------------------------------

# ============================ 1. 路径与行为 ============================

# 项目根目录。不设置时由 cli 自动向上查找含 pyproject.toml 的目录。
# 引用位置：src/kaoyanbench/core/config.py:117、src/kaoyanbench/cli.py:165
# KAOYANBENCH_ROOT=/workspace/KaoyanBench

# 主机名哈希盐值（隐私：结果里只落盘主机名哈希，不落真实主机名）。
# 引用位置：src/kaoyanbench/utils/hashing.py:11（HOSTNAME_SALT_ENV）
# KAOYANBENCH_HOST_SALT=change-me

# L2 Agent 层回放目录（预留语义，P2；v1.0 只做 L1 评分层回放）。
# 引用位置：src/kaoyanbench/core/workspace.py:207 / snapshot.py:13
# KAOYANBENCH_REPLAY_DIR=

#（由被测 Agent 子进程侧读取，非本进程直接使用）
# 引用位置：src/kaoyanbench/core/workspace.py:224、runners/command.py
# KAOYANBENCH_USAGE_FILE=          # 由 Agent 把 token/cost 写入该 JSON 文件
# KAOYANBENCH_ANSWER_FILE=         # Agent 的最终答案文件路径（框架注入）


# ==================== 2. 被测模型（config/default.yaml: model） ====================
# 用于 HttpRunner 型 Agent 访问 OpenAI 兼容端点，以及成本/用量推算。
# 引用位置：config/default.yaml:21-22（${OPENAI_BASE_URL} + api_key_env: OPENAI_API_KEY）
# 引用位置：src/kaoyanbench/core/runners/http.py:44-47

# 被测模型 base_url（OpenAI 兼容，形如 https://host/v1）。留空则 HttpRunner 不发起请求。
# OPENAI_BASE_URL=
# 被测模型 api key 所在的环境变量名由 config 的 api_key_env 指定，默认 OPENAI_API_KEY：
# OPENAI_API_KEY=


# ============ 3. 评测模型（Semantic Grader，config/default.yaml: grader_model） ============
# ★ 评测模型必须与被测模型分离（allow_same_model 默认 false，方案 R2）。
# 引用位置：config/default.yaml:28-29（${GRADER_BASE_URL} + api_key_env: GRADER_API_KEY）
# 引用位置：src/kaoyanbench/core/graders/semantic.py:243-268（无 key → degraded）

# 评测模型 base_url（OpenAI 兼容）。**不设置时 Semantic Grader 自动降级为 degraded**。
# GRADER_BASE_URL=
# 评测模型 api key（变量名由 config 的 grader_model.api_key_env 指定，默认 GRADER_API_KEY）：
# GRADER_API_KEY=


# ==================== 4. Agent 配置引用的环境变量（config/agents/*.yaml） ====================
# 这些变量由具体 Agent 配置卡片声明，运行时按需注入（env_passthrough 白名单）。
# 引用位置：config/agents/kaoyan_chain.yaml:30-31
# KAOYANBENCH 会透传给子进程的变量（仅在被 Agent 配置显式列入 env_passthrough 时）：
# OPENAI_BASE_URL=     # 同第 2 节
# OPENAI_API_KEY=      # 同第 2 节
# ANTHROPIC_API_KEY=   # 引用位置：config/agents/claude_code.yaml:21
# ANTHROPIC_BASE_URL=  # 引用位置：config/agents/claude_code.yaml:22
# WORKBUDDY_BASE_URL=  # 引用位置：config/agents/workbuddy.yaml:10（${WORKBUDDY_BASE_URL}）
# WORKBUDDY_API_KEY=   # 引用位置：config/agents/workbuddy.yaml:11（api_key_env）


# ==================== 5. CI 专用（可选，仅 nightly 用） ====================
# nightly workflow 会读取以下 secrets（未配置则语义评测降级，不使 job 失败）：
#   GRADER_BASE_URL / GRADER_API_KEY / OPENAI_BASE_URL / OPENAI_API_KEY
# PR 门禁（validate.yml / smoke.yml）**不依赖任何 secrets**。
